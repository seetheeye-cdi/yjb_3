rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // /scores: leaderboard entries.
    // Reads are public (Top 10 listing, rank lookup).
    // Writes are denied from clients — submissions go through the
    // submitScore Cloud Function which validates with admin privileges.
    match /scores/{scoreId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Optional: per-user metadata (last submission time, soft mute, etc.).
    // Owner can read their own doc; writes only via admin SDK in CFs.
    match /players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
